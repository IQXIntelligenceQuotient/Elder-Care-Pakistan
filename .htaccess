# Elder Care Pakistan static-site safety baseline.
# The current site uses root .html pages as canonical URLs.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:"
</IfModule>

<FilesMatch "^(?!contact\.php$).*\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.eldercarepakistan\.org$ [NC]
  RewriteRule ^ https://eldercarepakistan.org%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{THE_REQUEST} "\s/+index\.html[?\s]" [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule "^Donate-Now[ ]-[ ]Copy\.html$" /Donate-Now.html [R=301,L]
  RewriteRule ^about/?$ /About-Us.html [R=301,L]
  RewriteRule ^contact/?$ /Contact-Us.html [R=301,L]
  RewriteRule ^donate/?$ /Donate-Now1.html [R=301,L]
  RewriteRule ^our-work/medical-support/?$ /care-support.html [R=301,L]
</IfModule>
